<?xml version="1.0" encoding="UTF-8"?>
<!-- Classy Scrapers log / help viewer — Crew orchid + dark glass -->
<window>
	<controls>
		<control type="group">
			<left>280</left>
			<top>50</top>
			<control type="group">
				<width>1360</width>
				<!-- Panel body: deep charcoal with a hint of purple -->
				<control type="image">
					<height>980</height>
					<texture colordiffuse="FF1C1524">common/white.png</texture>
				</control>
				<!-- Soft inner frame -->
				<control type="image">
					<left>2</left>
					<top>100</top>
					<width>1356</width>
					<height>878</height>
					<texture colordiffuse="FF2A2038">common/white.png</texture>
				</control>
				<!-- Header bar: Crew orchid -->
				<control type="image">
					<height>100</height>
					<texture colordiffuse="FFDA70D6">common/white.png</texture>
				</control>
				<!-- Thin accent under header -->
				<control type="image">
					<top>100</top>
					<height>3</height>
					<texture colordiffuse="FFF0A8EC">common/white.png</texture>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>70</width>
					<height>70</height>
					<align>left</align>
					<aligny>top</aligny>
					<aspectratio aligny="top">keep</aspectratio>
					<texture>common/icon.png</texture>
				</control>
				<control type="label">
					<top>30</top>
					<left>105</left>
					<width max="1115">auto</width>
					<height>40</height>
					<font>font16</font>
					<textcolor>FF1C1524</textcolor>
					<shadowcolor>40FFFFFF</shadowcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>$INFO[Window().Property(classyscrapers.heading)]</label>
				</control>
				<control type="textbox" id="2000">
					<left>45</left>
					<top>114</top>
					<width>1254</width>
					<height>830</height>
					<onup>2000</onup>
					<ondown>2000</ondown>
					<scrolltime tween="sine">400</scrolltime>
					<font>font14</font>
					<textcolor>FFF5E9FA</textcolor>
					<label>$INFO[Window().Property(classyscrapers.text)]</label>
					<pagecontrol>2060</pagecontrol>
				</control>
				<control type="scrollbar" id="2060">
					<left>1320</left>
					<top>114</top>
					<width>30</width>
					<height>850</height>
					<texturesliderbackground colordiffuse="FF3A2F4A" border="15">scrollbars/scrollbaruni-bg.png</texturesliderbackground>
					<texturesliderbar colordiffuse="FF8B6B9A" border="15">scrollbars/scrollbaruni-bar.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="FFDA70D6" border="15">scrollbars/scrollbaruni-bar-focus.png</texturesliderbarfocus>
					<textureslidernib>scrollbars/scrollbaruni-nib.png</textureslidernib>
					<textureslidernibfocus>scrollbars/scrollbaruni-nib.png</textureslidernibfocus>
					<onleft>2060</onleft>
					<onright>2060</onright>
					<onup>2060</onup>
					<ondown>2060</ondown>
					<showonepage>false</showonepage>
					<orientation>vertical</orientation>
				</control>
			</control>
		</control>
	</controls>
</window>
